{
  "name": "diario-combriccola",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/unit.test.js",
    "test:rules": "firebase emulators:exec --project demo-combriccola --only firestore \"node --test tests/spark-rules.test.js\"",
    "test:integration": "firebase emulators:exec --project demo-combriccola --only auth,firestore \"node --test --test-concurrency=1 tests/spark-integration.test.js tests/spark-migration.test.js\""
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "sharp": "^0.35.5",
    "vite": "^7.0.0"
  }
}
